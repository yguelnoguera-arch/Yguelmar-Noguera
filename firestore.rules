rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test document
    match /test/{docId} {
      allow get: if true;
      allow write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'diasCompletados', 'semanaActual']) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL',
          'diasCompletados', 'semanaActual', 'semanasCompletadas',
          'completedDayIds', 'completedPracticeIds', 'currentPracticeId',
          'lastCompletedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.diasCompletados is number && data.diasCompletados >= 0 && data.diasCompletados <= 100 &&
        data.semanaActual is number && data.semanaActual >= 1 && data.semanaActual <= 20 &&
        (!('semanasCompletadas' in data) || (data.semanasCompletadas is number && data.semanasCompletadas >= 0 && data.semanasCompletadas <= 10)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('completedDayIds' in data) || (data.completedDayIds is list && data.completedDayIds.size() <= 50)) &&
        (!('completedPracticeIds' in data) || (data.completedPracticeIds is list && data.completedPracticeIds.size() <= 100)) &&
        (!('currentPracticeId' in data) || (data.currentPracticeId is string && data.currentPracticeId.size() <= 80)) &&
        (!('lastCompletedAt' in data) || (data.lastCompletedAt is string && data.lastCompletedAt.size() <= 60)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    // User Reflection Validation
    function isValidUserReflection(data) {
      return data.keys().hasAll(['id', 'userId', 'weekNumber', 'whatToRelease']) &&
        data.keys().hasOnly(['id', 'userId', 'weekNumber', 'dayNumber', 'practiceTitle', 'sensations', 'whatToRelease', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.weekNumber is number && data.weekNumber >= 1 && data.weekNumber <= 20 &&
        (!('dayNumber' in data) || (data.dayNumber is number && data.dayNumber >= 1 && data.dayNumber <= 7)) &&
        (!('practiceTitle' in data) || (data.practiceTitle is string && data.practiceTitle.size() <= 150)) &&
        (!('sensations' in data) || (data.sensations is list && data.sensations.size() <= 20)) &&
        data.whatToRelease is string && data.whatToRelease.size() <= 600 &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60));
    }

    // User Gratitude Entry Validation
    function isValidGratitudeEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'mood', 'note']) &&
        data.keys().hasOnly(['id', 'userId', 'mood', 'note', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.mood is string && data.mood.size() <= 50 &&
        data.note is string && data.note.size() <= 800 &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60));
    }

    // Match /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if false;

      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid;

      allow update: if isSignedIn() &&
        request.auth.uid == userId &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'diasCompletados',
          'semanaActual',
          'semanasCompletadas',
          'completedDayIds',
          'completedPracticeIds',
          'currentPracticeId',
          'lastCompletedAt',
          'updatedAt',
          'displayName',
          'photoURL',
          'email'
        ]);

      allow delete: if false;

      // Subcollection for user reflections
      match /reflections/{reflectionId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

        allow create: if isSignedIn() &&
          request.auth.uid == userId &&
          isValidId(userId) &&
          isValidId(reflectionId) &&
          isValidUserReflection(incoming()) &&
          incoming().userId == request.auth.uid;

        allow update: if isSignedIn() &&
          request.auth.uid == userId &&
          isValidId(userId) &&
          isValidId(reflectionId) &&
          isValidUserReflection(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'sensations',
            'whatToRelease',
            'practiceTitle',
            'dayNumber',
            'weekNumber'
          ]);

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(reflectionId);
      }

      // Subcollection for user gratitude journal entries
      match /gratitude/{gratitudeId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

        allow create: if isSignedIn() &&
          request.auth.uid == userId &&
          isValidId(userId) &&
          isValidId(gratitudeId) &&
          isValidGratitudeEntry(incoming()) &&
          incoming().userId == request.auth.uid;

        allow update: if isSignedIn() &&
          request.auth.uid == userId &&
          isValidId(userId) &&
          isValidId(gratitudeId) &&
          isValidGratitudeEntry(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['mood', 'note']);

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(gratitudeId);
      }
    }
  }
}
